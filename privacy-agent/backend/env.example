# Copy to .env (or export in your shell) and fill in locally. Never commit secrets.
# Mock mode is the default and needs no key.
LLM_MODE=mock

# Optional OpenAI-compatible planner. Leave empty to stay in mock mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25

# Comma-separated browser origins allowed to call this local backend.
ALLOWED_EXTENSION_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
